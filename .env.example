# ==============================================================================
# Discord Bot Configuration
# ==============================================================================
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id_here
# Optional: Set DISCORD_GUILD_ID for instant slash command registration during testing.
# Leave blank to deploy commands globally across all servers.
DISCORD_GUILD_ID=
# Automatically deploy slash commands on bot startup (true/false)
AUTO_DEPLOY_COMMANDS=true

# ==============================================================================
# PostgreSQL Database Configuration
# ==============================================================================
# You may provide DATABASE_URL OR individual PG_* parameters.
DATABASE_URL=postgresql://ttsbot:ttsbot_secure_password@localhost:5432/discord_tts
PGHOST=localhost
PGPORT=5432
PGUSER=ttsbot
PGPASSWORD=ttsbot_secure_password
PGDATABASE=discord_tts
PGSSL=false
PG_POOL_MAX=10

# ==============================================================================
# Local Piper TTS Engine Configuration
# ==============================================================================
# Path to the piper executable (e.g., /usr/local/bin/piper/piper or C:\piper\piper.exe)
PIPER_BIN_PATH=/usr/local/bin/piper/piper
# Directory containing downloaded .onnx and .onnx.json voice models
PIPER_MODELS_DIR=./models/piper
# Default voice model ID (must match <voice_id>.onnx in PIPER_MODELS_DIR)
DEFAULT_VOICE_MODEL=en_US-lessac-medium
DEFAULT_LANGUAGE=en_US
DEFAULT_SPEECH_SPEED=1.0
DEFAULT_VOLUME=100
DEFAULT_MAX_MESSAGE_LENGTH=300
# Temporary directory for generated WAV files (automatically cleaned up)
TTS_TEMP_DIR=./tmp/tts
# Optional custom FFmpeg binary path (leave blank to use ffmpeg-static or system ffmpeg)
FFMPEG_PATH=

# ==============================================================================
# Queue, Rate Limiting & Reliability
# ==============================================================================
# Maximum queued messages per Discord server
MAX_QUEUE_SIZE=50
# Minimum milliseconds between messages from the same user
USER_RATE_LIMIT_MS=2500
# Duplicate identical message cooldown per user in milliseconds
DUPLICATE_COOLDOWN_MS=15000
# Timeout for Piper synthesis in milliseconds
PIPER_TIMEOUT_MS=20000
# Voice gateway reconnect max attempts before pausing
VOICE_RECONNECT_MAX_ATTEMPTS=6
# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
NODE_ENV=production
# Health endpoint port (default 3000)
PORT=3000
